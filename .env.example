# Contact form delivery (https://resend.com). Until RESEND_API_KEY is set the form
# tells visitors to phone or email instead of pretending the message was sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "EN Law Website <website@enlaw.ca>"
CONTACT_FROM_EMAIL=
# Optional. Defaults to Elizabeth@enlaw.ca
CONTACT_TO_EMAIL=
